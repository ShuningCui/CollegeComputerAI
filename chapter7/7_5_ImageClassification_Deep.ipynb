    "import torchmetrics\n",
    "accuracy = torchmetrics.Accuracy(task='multiclass', num_classes=10)\n",
    "with torch.inference_mode():\n",
    "    for x,y in test_loader:\n",
    "        yhat = model(x)\n",
    "        accuracy(yhat, y)\n",
    "acc = accuracy.compute()\n",
    "print(f\"Test Accuracy: {acc.item() * 100:.2f}%\")"
